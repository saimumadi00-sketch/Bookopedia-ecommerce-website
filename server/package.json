{
  "name": "bookopedia-server",
  "version": "0.1.0",
  "private": true,
  "description": "Bookopedia REST API — CSE327 Software Engineering project",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node src/db/migrate.js --fresh && node src/db/seed.js",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=18"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./tests/globalSetup.js",
    "setupFiles": [
      "./tests/setupEnv.js"
    ],
    "testTimeout": 20000
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.5.0",
    "xss": "^1.0.17"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "supertest": "^7.3.2"
  }
}
