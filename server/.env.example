# Copy to .env and fill in. Never commit the real .env (NFR-06, NFR-07).
NODE_ENV=development
PORT=5000

# MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=bookopedia
DB_PASSWORD=change-me
DB_NAME=bookopedia

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
PASSWORD_RESET_TTL_MINUTES=15

# URLs (used for CORS and password-reset links)
FRONTEND_URL=http://localhost:5173

# SMTP (leave SMTP_HOST empty in development: emails are printed to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Bookopedia <no-reply@bookopedia.local>"

# Seed admin account (used by npm run db:seed)
SEED_ADMIN_EMAIL=admin@bookopedia.local
SEED_ADMIN_PASSWORD=Admin@12345
